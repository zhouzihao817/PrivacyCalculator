<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#000000"
        android:text="0"
        android:textSize="48sp"
        android:textColor="#FFFFFF"
        android:gravity="end|bottom"
        android:padding="16dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5">

        <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="C" android:textSize="24sp" android:background="#A5A5A5" android:textColor="#000000" />
        <Button android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="⌫" android:textSize="24sp" android:background="#A5A5A5" android:textColor="#000000" />
        <Button android:id="@+id/btnDiv" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="÷" android:textSize="24sp" android:background="#FF9500" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnMul" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="×" android:textSize="24sp" android:background="#FF9500" android:textColor="#FFFFFF" />

        <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="7" android:textSize="24sp" android:background="#333333" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="8" android:textSize="24sp" android:background="#333333" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="9" android:textSize="24sp" android:background="#333333" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnSub" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="-" android:textSize="24sp" android:background="#FF9500" android:textColor="#FFFFFF" />

        <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="4" android:textSize="24sp" android:background="#333333" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="5" android:textSize="24sp" android:background="#333333" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="6" android:textSize="24sp" android:background="#333333" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnAdd" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="+" android:textSize="24sp" android:background="#FF9500" android:textColor="#FFFFFF" />

        <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="1" android:textSize="24sp" android:background="#333333" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="2" android:textSize="24sp" android:background="#333333" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="3" android:textSize="24sp" android:background="#333333" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnEqual" android:layout_width="0dp" android:layout_height="160dp" android:layout_columnWeight="1" android:layout_rowSpan="2" android:text="=" android:textSize="24sp" android:background="#FF9500" android:textColor="#FFFFFF" />

        <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="2" android:layout_columnSpan="2" android:text="0" android:textSize="24sp" android:background="#333333" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="." android:textSize="24sp" android:background="#333333" android:textColor="#FFFFFF" />
    </GridLayout>
</LinearLayout>
